{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness Web GUI 桌面端：原生窗口 + 本地后端自动管理",
  "main": "main.js",
  "author": "dsh-desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.deepseek.dsh-desktop",
    "productName": "DeepSeek Harness Desktop",
    "copyright": "Copyright © 2025 DeepSeek Harness contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "close-dialog/*",
      "wallpaper-dialog/*",
      "chrome-preload.js",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "build/node.exe",
        "to": "node.exe"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        { "target": "portable" },
        { "target": "zip" }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DeepSeek-Harness-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeepSeek Harness",
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Desktop-${version}-portable.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
